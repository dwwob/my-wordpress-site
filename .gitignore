# Ignore the Podman database backup cache volume context
wp-content-locked/

# Exclude core server files (Only track your custom layouts)
wp-admin/
wp-includes/
*.php

# Explicitly bypass structural cascade rules to lock onto your custom theme folder
!wp-content/
wp-content/*
!wp-content/themes/
wp-content/themes/*
!wp-content/themes/beginner-developer-theme/

