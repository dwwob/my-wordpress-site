# 1. Ignore database volume layers and core server folders
wp-content-locked/
wp-admin/
wp-includes/

# 2. Block core root PHP scripts (Prevents pushing core engine files)
/index.php
/wp-activate.php
/wp-blog-header.php
/wp-comments-post.php
/wp-config-sample.php
/wp-cron.php
/wp-links-opml.php
/wp-load.php
/wp-login.php
/wp-mail.php
/wp-settings.php
/wp-signup.php
/wp-trackback.php
/xmlrpc.php

# 3. Block core content directories while keeping your custom theme
wp-content/languages/
wp-content/plugins/
wp-content/uploads/
wp-content/index.php
wp-content/themes/index.php
wp-content/themes/twentytwentythree/
wp-content/themes/twentytwentyfour/
wp-content/themes/twentytwentyfive/

